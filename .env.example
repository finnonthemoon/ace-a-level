EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

EXPO_PUBLIC_APP_ENV=development

# PostHog project token and regional ingestion host. These values are public
# client configuration, not PostHog personal API keys.
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google OAuth public client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# RevenueCat Test Store key (development builds only)
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_YOUR_TEST_STORE_KEY
# Production public SDK keys. Add these before making release builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_IOS_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_ANDROID_PUBLIC_SDK_KEY
# Use the production web public key (rcb_pk_...) in Cloudflare Pages.
# Keep sandbox keys (rcb_sb_...) local/staging only.
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_YOUR_WEB_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID="Ace A Level Pro"

# Required on the subscription screen before store submission
EXPO_PUBLIC_TERMS_OF_USE_URL=https://YOUR_A_LEVEL_DOMAIN/terms.html
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://YOUR_A_LEVEL_DOMAIN/privacy.html
